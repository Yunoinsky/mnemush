{
  "name": "mneme-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Mneme — brain-inspired memory for AI coding agents. Workspace root.",
  "workspaces": [
    "packages/mneme-client",
    "packages/mneme-pi",
    "packages/mneme-opencode"
  ],
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build:rust": "cargo build --release --manifest-path crates/mneme/Cargo.toml",
    "build:ts": "npm run build --workspaces --if-present",
    "build": "npm run build:rust && npm run build:ts",
    "test:rust": "cargo test --manifest-path crates/mneme/Cargo.toml",
    "test": "npm run test:rust"
  },
  "license": "MulanPSL-2.0"
}
